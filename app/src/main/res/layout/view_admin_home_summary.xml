<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/main_home_welcome_card"
    android:elevation="10dp"
    android:minHeight="142dp"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ibm_plex_sans_semibold"
        android:text="@string/admin_home_title"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/admin_home_subtitle"
        android:textColor="#D8ECFF"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/adminSummaryCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/ibm_plex_sans_semibold"
        android:textColor="#72E892"
        android:textSize="14sp" />
</LinearLayout>
