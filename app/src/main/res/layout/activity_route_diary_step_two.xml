<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/routeStepTwoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/route_diary_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnRouteStepTwoBack" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/route_back_description" android:padding="8dp" android:src="@drawable/ic_route_back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans_semibold" android:text="@string/route_diary_title" android:textColor="#FFFFFF" android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans_semibold" android:text="@string/route_step_two_count" android:textColor="#4DDD70" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/ibm_plex_sans_semibold" android:text="@string/route_step_two_title" android:textColor="#FFFFFF" android:textSize="22sp" />
            </LinearLayout>
            <TextView android:layout_width="78dp" android:layout_height="38dp" android:background="@drawable/route_diary_badge" android:fontFamily="@font/ibm_plex_sans_semibold" android:gravity="center" android:text="@string/route_step_two_badge" android:textColor="#FFFFFF" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="14dp" android:orientation="horizontal" android:weightSum="7">
            <View android:layout_width="0dp" android:layout_height="6dp" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/route_progress_active" />
            <View android:layout_width="0dp" android:layout_height="6dp" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/route_progress_active" />
            <View android:layout_width="0dp" android:layout_height="6dp" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/route_progress_active" />
            <View android:layout_width="0dp" android:layout_height="6dp" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/route_progress_active" />
            <View android:layout_width="0dp" android:layout_height="6dp" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/route_progress_inactive" />
            <View android:layout_width="0dp" android:layout_height="6dp" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/route_progress_inactive" />
            <View android:layout_width="0dp" android:layout_height="6dp" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@drawable/route_progress_inactive" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/route_diary_surface" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="38dp" android:gravity="bottom" android:text="@string/route_arrival_date" android:textColor="#C7D4EE" android:textSize="13sp" />
                    <EditText android:id="@+id/inputRouteArrivalDate" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/route_diary_input" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:hint="@string/route_date_hint" android:inputType="none" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#8298BF" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="38dp" android:gravity="bottom" android:text="@string/route_arrival_time" android:textColor="#C7D4EE" android:textSize="13sp" />
                    <EditText android:id="@+id/inputRouteArrivalTime" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/route_diary_input" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:hint="@string/route_time_hint" android:inputType="none" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#8298BF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="38dp" android:gravity="bottom" android:text="@string/route_unloading_time" android:textColor="#C7D4EE" android:textSize="13sp" />
                    <EditText android:id="@+id/inputRouteUnloadingTime" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/route_diary_input" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:hint="@string/route_time_hint" android:inputType="none" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" android:textColorHint="#8298BF" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="38dp" android:gravity="bottom" android:text="@string/route_arrival_km" android:textColor="#C7D4EE" android:textSize="13sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/route_diary_input" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="14dp">
                        <EditText android:id="@+id/inputRouteArrivalKm" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:digits="0123456789" android:hint="@string/route_km_hint" android:inputType="number" android:maxLength="3" android:padding="0dp" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#8298BF" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans_semibold" android:text="@string/route_km_suffix" android:textColor="#C7D4EE" android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/route_corral_number" android:textColor="#C7D4EE" android:textSize="13sp" />
            <EditText android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/route_diary_input" android:inputType="number" android:paddingHorizontal="12dp" android:textColor="#FFFFFF" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:background="@drawable/route_duration_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/ibm_plex_sans_semibold" android:text="@string/route_reverse_alarm" android:textColor="#FFFFFF" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/alarmToggleGroup" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" app:selectionRequired="true" app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnAlarmYes" android:layout_width="62dp" android:layout_height="32dp" android:layout_marginEnd="8dp" android:checkable="true" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:text="@string/route_yes" android:textAllCaps="false" android:textColor="@color/route_toggle_text" android:textSize="12sp" app:backgroundTint="@color/route_toggle_background" app:cornerRadius="16dp" app:strokeWidth="0dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnAlarmNo" android:layout_width="62dp" android:layout_height="32dp" android:checkable="true" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:text="@string/route_no" android:textAllCaps="false" android:textColor="@color/route_toggle_text" android:textSize="12sp" app:backgroundTint="@color/route_toggle_background" app:cornerRadius="16dp" app:strokeWidth="0dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginTop="22dp" android:background="@drawable/route_duration_background" android:drawableStart="@drawable/ic_route_clock" android:drawablePadding="12dp" android:fontFamily="@font/ibm_plex_sans_semibold" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="@string/route_duration_calculated" android:textColor="#FFFFFF" android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnRouteStepTwoContinue" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="20dp" android:layout_marginTop="42dp" android:layout_marginEnd="20dp" android:backgroundTint="#4DDD70" android:fontFamily="@font/ibm_plex_sans_semibold" android:text="@string/route_continue" android:textAllCaps="false" android:textColor="#002064" android:textSize="18sp" app:cornerRadius="28dp" />
    </LinearLayout>
</ScrollView>
