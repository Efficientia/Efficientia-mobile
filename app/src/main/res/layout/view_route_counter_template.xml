<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="116dp" android:layout_weight="1"
    android:layout_marginHorizontal="4dp" android:background="@drawable/route_counter_card"
    android:gravity="center" android:orientation="vertical" android:padding="8dp">
    <TextView android:id="@+id/counterLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="@font/ibm_plex_sans_semibold" android:textColor="#FFFFFF" android:textSize="12sp" />
    <TextView android:id="@+id/counterValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="@font/ibm_plex_sans_semibold" android:textColor="#FFFFFF" android:textSize="24sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="7dp" android:gravity="center" android:orientation="horizontal">
        <ImageButton android:id="@+id/counterMinus" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/route_counter_minus" android:contentDescription="@string/route_decrease" android:src="@android:drawable/ic_delete" android:tint="#FFFFFF" />
        <ImageButton android:id="@+id/counterPlus" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/route_counter_plus" android:contentDescription="@string/route_increase" android:src="@drawable/ic_add" android:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
