<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_home_background"
    tools:context=".main.DriverProfileActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="62dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnProfileTopHome"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/home_icon_description"
                        android:padding="10dp"
                        android:src="@drawable/ic_nav_home"
                        app:tint="#1552A1" />

                    <ImageButton
                        android:id="@+id/btnProfileNotifications"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/notification_icon_description"
                        android:padding="10dp"
                        android:src="@drawable/ic_home_notification"
                        android:translationY="1dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDriverProfile"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/main_home_profile_background"
                    android:contentDescription="@string/main_home_profile_description"
                    android:padding="6dp"
                    android:src="@drawable/ic_profile_placeholder" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtDriverProfileGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:textColor="#062A68"
                android:textSize="23sp"
                tools:text="Olá, Ygona Mendes!" />

            <TextView
                android:id="@+id/txtDriverProfileSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#1552A1"
                android:textSize="12sp"
                tools:text="Motorista • CNH categoria E" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEditDriverProfile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/main_home_action_green"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/profile_edit"
                android:textAllCaps="false"
                android:textColor="#002060"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDriverPreferences"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/main_home_action_blue"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/profile_preferences"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/profile_my_data"
                android:textColor="#062A68"
                android:textSize="18sp" />

            <include
                android:id="@+id/profileCpfField"
                layout="@layout/view_profile_data_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <include
                android:id="@+id/profileCnhField"
                layout="@layout/view_profile_data_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/profilePhoneField"
                layout="@layout/view_profile_data_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/profileCompanyField"
                layout="@layout/view_profile_data_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/profileEmailField"
                layout="@layout/view_profile_data_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnViewDriverSignature"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/main_home_action_blue"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/profile_view_signature"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDriverLogout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/profile_logout_background"
                android:text="@string/profile_logout"
                android:textAllCaps="false"
                android:textColor="#E00000"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/profileBottomToolbar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/main_home_bottom_bar"
        android:elevation="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/navProfileHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/home_icon_description"
                android:src="@drawable/ic_nav_home" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfileSelected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/main_home_nav_selected"
                android:contentDescription="@string/main_home_profile_description"
                android:padding="10dp"
                android:src="@drawable/ic_nav_profile" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfileDocuments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_documents_description"
                android:src="@drawable/ic_nav_document" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfileAssistant"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_assistant_description"
                android:src="@drawable/ic_nav_assistant" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navProfileSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_settings_description"
                android:src="@drawable/ic_nav_settings" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
