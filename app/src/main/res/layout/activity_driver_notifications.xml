<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notificationsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_home_background"
    tools:context=".main.DriverNotificationsActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="104dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="62dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnNotificationsTopHome"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/home_icon_description"
                        android:padding="10dp"
                        android:src="@drawable/ic_nav_home"
                        app:tint="#1552A1" />

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/notification_icon_description"
                        android:padding="10dp"
                        android:src="@drawable/ic_home_notification"
                        android:translationY="1dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgNotificationsProfile"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/main_home_profile_background"
                    android:contentDescription="@string/main_home_profile_description"
                    android:padding="6dp"
                    android:src="@drawable/ic_profile_placeholder" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/notifications_title"
                android:textColor="#062A68"
                android:textSize="23sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDisableNotifications"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:background="@drawable/settings_option_background"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/notifications_disable_action"
                android:textAllCaps="false"
                android:textColor="#062A68"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtNotificationsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="54dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/notifications_empty"
                android:textColor="#5D6980"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnableNotifications"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/main_home_action_green"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/notifications_enable_action"
                android:textAllCaps="false"
                android:textColor="#002060"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/notificationsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/main_home_bottom_bar"
        android:elevation="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/navNotificationsHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/home_icon_description"
                android:src="@drawable/ic_nav_home" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navNotificationsProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_profile_description"
                android:src="@drawable/ic_nav_profile" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navNotificationsDocuments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_documents_description"
                android:src="@drawable/ic_nav_document" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navNotificationsAssistant"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_assistant_description"
                android:src="@drawable/ic_nav_assistant" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navNotificationsSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_settings_description"
                android:src="@drawable/ic_nav_settings" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
