<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/feedbackRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_home_background"
    tools:context=".feedback.RouteFeedbackActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/feedbackScrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/feedbackBottomToolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="18dp"
            android:paddingEnd="26dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnFeedbackBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/feedback_back_description"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#063277" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/ibm_plex_sans_semibold"
                    android:text="@string/feedback_title"
                    android:textColor="#063277"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/feedback_question"
                android:textColor="#062E70"
                android:textSize="25sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="@string/feedback_subtitle"
                android:textColor="#53778D"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="4">

                <TextView
                    android:id="@+id/ratingGreat"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/feedback_rating_selector"
                    android:contentDescription="@string/feedback_rating_great"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:text="😀"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/ratingGood"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/feedback_rating_selector"
                    android:contentDescription="@string/feedback_rating_good"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:text="🙂"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/ratingRegular"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/feedback_rating_selector"
                    android:contentDescription="@string/feedback_rating_regular"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:text="😐"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/ratingBad"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/feedback_rating_selector"
                    android:contentDescription="@string/feedback_rating_bad"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:text="☹️"
                    android:textSize="30sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="42dp"
                android:text="@string/feedback_impact_question"
                android:textColor="#53778D"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="4dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="2dp"
                app:singleLine="false"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEntrance"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:checkable="true"
                    android:text="@string/feedback_reason_entrance"
                    android:textColor="#0875F5"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/feedback_chip_background"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeColor="@color/feedback_chip_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWait"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:checkable="true"
                    android:text="@string/feedback_reason_wait"
                    android:textColor="#0875F5"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/feedback_chip_background"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeColor="@color/feedback_chip_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHeat"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:checkable="true"
                    android:text="@string/feedback_reason_heat"
                    android:textColor="#0875F5"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/feedback_chip_background"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeColor="@color/feedback_chip_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCorral"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:checkable="true"
                    android:text="@string/feedback_reason_corral"
                    android:textColor="#0875F5"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/feedback_chip_background"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeColor="@color/feedback_chip_stroke"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilling"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:checkable="true"
                    android:text="@string/feedback_reason_filling"
                    android:textColor="#0875F5"
                    android:textSize="13sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/feedback_chip_background"
                    app:chipCornerRadius="18dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeColor="@color/feedback_chip_stroke"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>

            <EditText
                android:id="@+id/inputFeedbackComment"
                android:layout_width="match_parent"
                android:layout_height="122dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/feedback_comment_background"
                android:gravity="top|start"
                android:hint="@string/feedback_comment_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="16dp"
                android:textColor="#063277"
                android:textColorHint="#9AA6AD"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitFeedback"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="18dp"
                android:backgroundTint="#4DDB70"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/feedback_submit"
                android:textAllCaps="false"
                android:textColor="#062E70"
                android:textSize="15sp"
                app:cornerRadius="27dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/feedbackBottomToolbar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/main_home_bottom_bar"
        android:elevation="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/navFeedbackHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/home_icon_description"
                android:src="@drawable/ic_nav_home" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navFeedbackProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_profile_description"
                android:src="@drawable/ic_nav_profile" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navFeedbackDocuments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_documents_description"
                android:src="@drawable/ic_nav_document" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navFeedbackAssistant"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_assistant_description"
                android:src="@drawable/ic_nav_assistant" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navFeedbackSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_gravity="center"
                android:contentDescription="@string/main_home_settings_description"
                android:src="@drawable/ic_nav_settings" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
