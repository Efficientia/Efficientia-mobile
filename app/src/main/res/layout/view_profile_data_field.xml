<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="62dp"
    android:background="@drawable/profile_data_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/profileFieldLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#1767D7"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/profileFieldValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/ibm_plex_sans_semibold"
        android:textColor="#062A68"
        android:textSize="14sp" />
</LinearLayout>
