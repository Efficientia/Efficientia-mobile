<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/authenticated_splash_gradient"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    tools:context=".splash.AuthenticatedSplashActivity">

    <ImageView
        android:id="@+id/imgAuthenticatedLogo"
        android:layout_width="164dp"
        android:layout_height="158dp"
        android:layout_marginTop="64dp"
        android:contentDescription="@string/recuperar_logo"
        android:src="@drawable/logo_effi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtAuthenticatedGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp"
        android:fontFamily="@font/ibm_plex_sans_semibold"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgAuthenticatedLogo"
        tools:text="Olá, Motorista Mobile Teste!" />

    <TextView
        android:id="@+id/txtAuthenticatedWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/ibm_plex_sans_semibold"
        android:text="@string/authenticated_splash_welcome"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtAuthenticatedGreeting" />

    <ProgressBar
        android:id="@+id/authenticatedProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginBottom="110dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/authenticated_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
