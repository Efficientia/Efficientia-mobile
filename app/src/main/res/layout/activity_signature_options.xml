<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/signature_background"
    android:fillViewport="true"
    tools:context=".signature.SignatureOptionsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minHeight="760dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="48dp"
        android:paddingEnd="18dp"
        android:paddingBottom="48dp">

        <ImageView
            android:layout_width="138dp"
            android:layout_height="133dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_effi" />

        <ImageView
            android:layout_width="158dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/signature_brand"
            android:src="@drawable/efficientiatext" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="58dp"
            android:background="@drawable/signature_card"
            android:elevation="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="28dp"
            android:paddingEnd="26dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/signature_choose_option"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDrawSignature"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="42dp"
                android:background="@drawable/componente_button_green"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/signature_draw_option"
                android:textAllCaps="false"
                android:textColor="#002060"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTypeSignature"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/componente_button_blue"
                android:fontFamily="@font/ibm_plex_sans_semibold"
                android:text="@string/signature_type_option"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
