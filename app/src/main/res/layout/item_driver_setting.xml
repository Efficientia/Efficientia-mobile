<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_option_background"
    android:gravity="center_vertical"
    android:minHeight="59dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingsOptionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ibm_plex_sans_semibold"
            android:textColor="#062A68"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/settingsOptionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8994A4"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="›"
        android:textColor="#97A4B4"
        android:textSize="25sp" />
</LinearLayout>
