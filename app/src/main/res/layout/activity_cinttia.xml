<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cinttiaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_home_background">

    <LinearLayout android:id="@+id/cinttiaHeader" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="16dp"
        android:paddingEnd="24dp" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout android:layout_width="match_parent" android:layout_height="60dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ImageButton android:id="@+id/cinttiaTopHome" android:layout_width="44dp"
                    android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_nav_home"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_icon_description" app:tint="#1552A1" />
                <ImageButton android:id="@+id/cinttiaNotifications" android:layout_width="44dp"
                    android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_home_notification"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/notification_icon_description" />
            </LinearLayout>
            <ImageButton android:id="@+id/cinttiaProfile" android:layout_width="54dp"
                android:layout_height="54dp" android:layout_gravity="end|center_vertical"
                android:background="@drawable/main_home_profile_background" android:padding="6dp"
                android:src="@drawable/ic_profile_placeholder"
                android:contentDescription="@string/main_home_profile_description" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/cinttia_title"
                android:fontFamily="@font/ibm_plex_sans_semibold" android:textColor="#062A68"
                android:textSize="24sp" />
            <TextView android:id="@+id/cinttiaClear" android:layout_width="wrap_content"
                android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:text="@string/cinttia_clear_action" android:textColor="#1552A1"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="@string/cinttia_subtitle"
            android:textColor="#36557D" android:textSize="13sp" />
    </LinearLayout>

    <ScrollView android:id="@+id/cinttiaScroll" android:layout_width="0dp"
        android:layout_height="0dp" android:clipToPadding="false" android:fillViewport="true"
        android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/cinttiaHeader"
        app:layout_constraintBottom_toTopOf="@id/cinttiaComposer"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/cinttiaMessages" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>

    <LinearLayout android:id="@+id/cinttiaComposer" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp" android:layout_marginBottom="6dp"
        android:orientation="vertical" app:layout_constraintBottom_toTopOf="@id/cinttiaBottomBar"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/cinttiaStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingBottom="4dp"
            android:textColor="#A32636" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/cinttia_input_background" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="6dp">
            <EditText android:id="@+id/cinttiaInput" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:background="@android:color/transparent" android:hint="@string/cinttia_hint"
                android:inputType="textCapSentences|textMultiLine" android:maxLines="4"
                android:minHeight="48dp" android:textColor="#062A68" android:textSize="14sp" />
            <TextView android:id="@+id/cinttiaSend" android:layout_width="wrap_content"
                android:layout_height="44dp" android:gravity="center" android:paddingStart="14dp"
                android:paddingEnd="14dp" android:background="@drawable/main_home_action_green"
                android:text="@string/cinttia_send" android:textColor="#062A68"
                android:fontFamily="@font/ibm_plex_sans_semibold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/cinttiaBottomBar" android:layout_width="0dp"
        android:layout_height="68dp" android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp" android:layout_marginBottom="14dp"
        android:background="@drawable/main_home_bottom_bar" android:elevation="14dp"
        android:gravity="center" android:orientation="horizontal" android:paddingStart="8dp"
        android:paddingEnd="8dp" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout android:id="@+id/navCinttiaHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:contentDescription="@string/home_icon_description" android:src="@drawable/ic_nav_home" />
        </FrameLayout>
        <FrameLayout android:id="@+id/navCinttiaProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:contentDescription="@string/main_home_profile_description" android:src="@drawable/ic_nav_profile" />
        </FrameLayout>
        <FrameLayout android:id="@+id/navCinttiaDocuments" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:contentDescription="@string/main_home_documents_description" android:src="@drawable/ic_nav_document" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:background="@drawable/main_home_nav_selected" android:padding="10dp" android:contentDescription="@string/main_home_assistant_description" android:src="@drawable/ic_nav_assistant" />
        </FrameLayout>
        <FrameLayout android:id="@+id/navCinttiaSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView android:layout_width="29dp" android:layout_height="29dp" android:layout_gravity="center" android:contentDescription="@string/main_home_settings_description" android:src="@drawable/ic_nav_settings" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
