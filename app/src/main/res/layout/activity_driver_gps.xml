<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gpsRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/main_home_background">

    <FrameLayout android:id="@+id/gpsMapContainer" android:layout_width="0dp"
        android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp" android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/gpsSearchBar" android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@drawable/cinttia_input_background" android:elevation="8dp"
            android:contentDescription="@string/gps_search_hint"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnGpsBack" android:layout_width="48dp"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/gps_back" android:padding="12dp"
                android:src="@drawable/ic_arrow_back" app:tint="#1552A1" />
            <TextView android:id="@+id/btnGpsSearch" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:gravity="center_vertical" android:paddingStart="6dp"
                android:text="@string/gps_search_hint" android:textColor="#36557D"
                android:textSize="15sp" />
            <ImageView android:layout_width="42dp" android:layout_height="42dp"
                android:contentDescription="@string/gps_search_hint" android:padding="10dp"
                android:src="@drawable/ic_gps_search" app:tint="#1552A1" />
        </LinearLayout>

        <TextView android:id="@+id/txtGpsStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:background="@drawable/settings_option_background" android:elevation="5dp"
            android:padding="12dp" android:text="@string/gps_loading"
            android:textColor="#062A68" android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnGpsMyLocation" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginEnd="20dp"
        android:layout_marginBottom="184dp" android:contentDescription="@string/gps_my_location"
        android:src="@drawable/ic_home_gps" app:backgroundTint="#FFFFFF"
        app:fabSize="mini" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:tint="#1552A1" />

    <LinearLayout android:id="@+id/gpsPlaceCard" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" android:layout_marginBottom="20dp"
        android:background="@drawable/settings_option_background" android:elevation="8dp"
        android:orientation="vertical" android:padding="16dp" android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/txtGpsPlaceName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="@font/ibm_plex_sans_semibold"
            android:textColor="#062A68" android:textSize="17sp" />
        <TextView android:id="@+id/txtGpsPlaceAddress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:maxLines="2" android:textColor="#36557D" android:textSize="12sp" />
        <TextView android:id="@+id/txtGpsAttributions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="#36557D" android:textSize="10sp" android:visibility="gone" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnGpsDirections"
            android:layout_width="match_parent" android:layout_height="42dp"
            android:layout_marginTop="12dp" android:background="@drawable/main_home_action_green"
            android:text="@string/gps_directions" android:textAllCaps="false"
            android:textColor="#062A68" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/gps_directions_note"
            android:textColor="#5D6980" android:textSize="10sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
