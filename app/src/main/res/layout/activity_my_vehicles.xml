<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/myVehiclesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_home_background"
    tools:context=".main.MyVehiclesActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vehiclesPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/vehicles_panel_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/vehiclesScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/vehiclesBottomToolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="25dp"
                android:paddingTop="18dp"
                android:paddingEnd="25dp"
                android:paddingBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnVehiclesBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/vehicles_back"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#062A68" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ibm_plex_sans_semibold"
                            android:text="@string/vehicles_title"
                            android:textColor="#062A68"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vehicles_subtitle"
                            android:textColor="#49748A"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/vehicles_card_background"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:contentDescription="@string/vehicles_truck_icon"
                            android:src="@drawable/ic_truck" />

                        <TextView
                            android:layout_width="86dp"
                            android:layout_height="26dp"
                            android:layout_gravity="end|center_vertical"
                            android:background="@drawable/vehicles_active_badge"
                            android:fontFamily="@font/ibm_plex_sans_semibold"
                            android:gravity="center"
                            android:text="@string/vehicles_active"
                            android:textColor="#07326A"
                            android:textSize="10sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/ibm_plex_sans_semibold"
                        android:text="@string/vehicles_truck_name"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vehicles_truck_details"
                        android:textColor="#C9D9F4"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/vehicles_card_background"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@string/vehicles_trailer_icon"
                        android:src="@drawable/ic_truck" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/ibm_plex_sans_semibold"
                        android:text="@string/vehicles_trailer_name"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vehicles_trailer_details"
                        android:textColor="#C9D9F4"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    android:fontFamily="@font/ibm_plex_sans_semibold"
                    android:text="@string/vehicles_summary"
                    android:textColor="#062A68"
                    android:textSize="21sp" />

                <include layout="@layout/view_vehicles_stats" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/vehiclesBottomToolbar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@drawable/main_home_bottom_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout android:id="@+id/navVehiclesHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:contentDescription="@string/home_icon_description" android:src="@drawable/ic_nav_home" />
            </FrameLayout>
            <FrameLayout android:id="@+id/navVehiclesProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:contentDescription="@string/main_home_profile_description" android:src="@drawable/ic_nav_profile" />
            </FrameLayout>
            <FrameLayout android:id="@+id/navVehiclesDocuments" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:contentDescription="@string/main_home_documents_description" android:src="@drawable/ic_nav_document" />
            </FrameLayout>
            <FrameLayout android:id="@+id/navVehiclesAssistant" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:contentDescription="@string/main_home_assistant_description" android:src="@drawable/ic_nav_assistant" />
            </FrameLayout>
            <FrameLayout android:id="@+id/navVehiclesSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="29dp" android:layout_height="29dp" android:layout_gravity="center" android:contentDescription="@string/main_home_settings_description" android:src="@drawable/ic_nav_settings" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
