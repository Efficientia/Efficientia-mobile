<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Efficientiamobile" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Efficientiamobile" parent="Base.Theme.Efficientiamobile" />

    <style name="Theme.Efficientiamobile.RouteDiary" parent="Theme.Efficientiamobile">
        <item name="android:windowAnimationStyle">@style/Animation.Efficientiamobile.Instant</item>
    </style>

    <style name="Theme.Efficientiamobile.Sections" parent="Theme.Efficientiamobile">
        <item name="android:windowAnimationStyle">@style/Animation.Efficientiamobile.Instant</item>
    </style>

    <style name="Animation.Efficientiamobile.Instant" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/route_no_transition</item>
        <item name="android:activityOpenExitAnimation">@anim/route_no_transition</item>
        <item name="android:activityCloseEnterAnimation">@anim/route_no_transition</item>
        <item name="android:activityCloseExitAnimation">@anim/route_no_transition</item>
    </style>
</resources>
